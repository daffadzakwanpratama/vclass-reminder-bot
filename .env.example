# ============================================================
#  VClass Reminder Bot — Environment Variables
#  Copy this file to .env and fill in your real values.
# ============================================================

# --- VClass / Moodle ---
VCLASS_URL=https://v-class.gunadarma.ac.id
VCLASS_USERNAME=your_student_email@student.gunadarma.ac.id
VCLASS_PASSWORD=your_password
VCLASS_SERVICE=moodle_mobile_app

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
